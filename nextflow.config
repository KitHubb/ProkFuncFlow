params.gtdbtk_db = '/data/Reference/GTDBTK/release226'
params.gtdb_batch_size = 20
params.skip_c00 = false
params.run_downstream = false
params.representatives_manifest = null
params.prokka_container = '/data/software/singularity/prokka.sif'
params.panaroo_container = '/data/software/singularity/panaroo.sif'
params.eggnog_container = '/data/software/singularity/eggnog-mapper/eggnog-mapper_2.1.15--pyhdfd78af_0.sif'
params.kofam_container = '/data/software/singularity/kofamscan/kofamscan_1.3.0--hdfd78af_2.sif'
params.gapseq_container = '/data/software/singularity/gapseq/gapseq_2.1.0--hdfd78af_0.sif'

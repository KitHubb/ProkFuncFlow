nextflow.enable.dsl = 2

params.manifest = null
params.analysis_config = "${projectDir}/config/analysis.yml"
params.run_id = null
params.outdir = null
params.checkm2_container = '/data/software/singularity/checkm2_1.0.2.sif'
params.gtdbtk_container = '/data/software/singularity/gtdbtk_2.6.1--pyh1f0d9b5_2.sif'

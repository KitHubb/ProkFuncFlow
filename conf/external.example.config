// Copy this file outside the repository, replace every /absolute/path value,
// then add: -c /path/to/your.config
params {
  checkm2_db = '/absolute/path/checkm2/uniref100.KO.1.dmnd'
  gtdbtk_db = '/absolute/path/gtdb/release226'
  eggnog_db = '/absolute/path/eggnog/5.0.2'
  kofam_profiles = '/absolute/path/kofam/profiles'
  kofam_ko_list = '/absolute/path/kofam/ko_list'
  anvio_kegg_data = '/absolute/path/anvio/KEGG'
  // Optional: use a host gapseq DB instead of the DB bundled in the image.
  // gapseq_db = '/absolute/path/gapseq/Bacteria'
}

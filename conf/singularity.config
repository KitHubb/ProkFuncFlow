docker.enabled = false
singularity.enabled = true
singularity.autoMounts = true
singularity.runOptions = '--cleanenv'

// Singularity requires an explicit transport scheme for OCI registry images.
params.checkm2_container = params.checkm2_container.startsWith('/') || params.checkm2_container.startsWith('docker://') ? params.checkm2_container : "docker://${params.checkm2_container}"
params.gtdbtk_container = params.gtdbtk_container.startsWith('/') || params.gtdbtk_container.startsWith('docker://') ? params.gtdbtk_container : "docker://${params.gtdbtk_container}"
params.drep_container = params.drep_container.startsWith('/') || params.drep_container.startsWith('docker://') ? params.drep_container : "docker://${params.drep_container}"
params.prokka_container = params.prokka_container.startsWith('/') || params.prokka_container.startsWith('docker://') ? params.prokka_container : "docker://${params.prokka_container}"
params.panaroo_container = params.panaroo_container.startsWith('/') || params.panaroo_container.startsWith('docker://') ? params.panaroo_container : "docker://${params.panaroo_container}"
params.eggnog_container = params.eggnog_container.startsWith('/') || params.eggnog_container.startsWith('docker://') ? params.eggnog_container : "docker://${params.eggnog_container}"
params.kofam_container = params.kofam_container.startsWith('/') || params.kofam_container.startsWith('docker://') ? params.kofam_container : "docker://${params.kofam_container}"
params.gapseq_container = params.gapseq_container.startsWith('/') || params.gapseq_container.startsWith('docker://') ? params.gapseq_container : "docker://${params.gapseq_container}"
params.anvio_container = params.anvio_container.startsWith('/') || params.anvio_container.startsWith('docker://') ? params.anvio_container : "docker://${params.anvio_container}"
